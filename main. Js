// ======================================================
// BANQUE FACILE - MAIN.JS
// Fonctionnement principal de l'application
// ======================================================

document.addEventListener("DOMContentLoaded", () => {

    console.log("Banque Facile : application démarrée");

    // --------------------------------------------------
    // AFFICHAGE DE LA DATE
    // --------------------------------------------------

    const dateElements = document.querySelectorAll("[data-date]");

    if (dateElements.length > 0) {
        const maintenant = new Date();

        const date = maintenant.toLocaleDateString("fr-FR", {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric"
        });

        dateElements.forEach(element => {
            element.textContent =
                date.charAt(0).toUpperCase() + date.slice(1);
        });
    }


    // --------------------------------------------------
    // BOUTONS DE NAVIGATION
    // --------------------------------------------------

    const boutonsConnexion =
        document.querySelectorAll("[data-connexion]");

    boutonsConnexion.forEach(bouton => {
        bouton.addEventListener("click", () => {
            window.location.href = "connexion.html";
        });
    });


    const boutonsInscription =
        document.querySelectorAll("[data-inscription]");

    boutonsInscription.forEach(bouton => {
        bouton.addEventListener("click", () => {
            window.location.href = "inscription.html";
        });
    });


    // --------------------------------------------------
    // AFFICHER / MASQUER LE SOLDE
    // --------------------------------------------------

    const boutonSolde =
        document.querySelector("[data-toggle-solde]");

    const solde =
        document.querySelector("[data-solde]");

    if (boutonSolde && solde) {

        let visible = true;

        boutonSolde.addEventListener("click", () => {

            visible = !visible;

            if (visible) {
                solde.textContent =
                    solde.dataset.value || "0 FCFA";

                boutonSolde.textContent =
                    "Masquer le solde";
            } else {
                solde.textContent = "••••••••";

                boutonSolde.textContent =
                    "Afficher le solde";
            }
        });
    }


    // --------------------------------------------------
    // ANIMATION DES CARTES
    // --------------------------------------------------

    const cartes =
        document.querySelectorAll(".card, .dashboard-card, .feature-card");

    cartes.forEach((carte, index) => {

        carte.style.opacity = "0";
        carte.style.transform = "translateY(15px)";

        setTimeout(() => {

            carte.style.transition =
                "opacity 0.5s ease, transform 0.5s ease";

            carte.style.opacity = "1";
            carte.style.transform = "translateY(0)";

        }, index * 100);
    });


    // --------------------------------------------------
    // BOUTON RETOUR À L'ACCUEIL
    // --------------------------------------------------

    const retourAccueil =
        document.querySelectorAll("[data-home]");

    retourAccueil.forEach(bouton => {

        bouton.addEventListener("click", () => {
            window.location.href = "index.html";
        });

    });

});
