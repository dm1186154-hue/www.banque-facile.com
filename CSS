.form-group {
    width: 100%;
    text-align: left;
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-size: 17px;
    font-weight: 600;
    color: #333;
}

.form-group input {
    width: 100%;
    padding: 16px;
    border: 1px solid #d5dce7;
    border-radius: 12px;
    font-size: 16px;
    outline: none;
}

.form-group input:focus {
    border-color: #087ee8;
}

.forgot-password {
    text-align: right;
    margin-bottom: 25px;
}

.forgot-password a {
    color: #087ee8;
    text-decoration: none;
}

.form-message {
    margin-top: 15px;
    font-size: 15px;
}

.back-home {
    display: inline-block;
    margin-top: 25px;
    color: #087ee8;
    text-decoration: none;
}
