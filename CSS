/* =====================================================
   BANQUE FACILE
   STYLE PRINCIPAL
   ===================================================== */


/* ================= RESET ================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f7f9fc;
    color: #172033;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    display: block;
    max-width: 100%;
}

.container {
    width: min(1120px, 92%);
    margin: auto;
}


/* ================= HEADER ================= */

.header {
    background: #ffffff;
    border-bottom: 1px solid #e5eaf1;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav {
    min-height: 80px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;
}


/* LOGO */

.logo {
    display: flex;
    align-items: center;
    gap: 12px;

    font-size: 21px;
    font-weight: 800;
}

.logo img {
    width: 48px;
    height: 48px;

    object-fit: contain;

    border-radius: 10px;

    background: #000000;
}

.navigation {
    display: flex;
    align-items: center;
    gap: 25px;
}

.navigation a {
    font-size: 15px;
    font-weight: 600;

    transition: 0.3s;
}

.navigation a:hover,
.navigation .active {
    color: #1266f1;
}


/* CONNEXION */

.btn-login {
    background: #1266f1;
    color: white !important;

    padding: 11px 20px;

    border-radius: 8px;
}


/* ================= HERO ================= */

.hero {
    padding: 90px 0;

    background:
        linear-gradient(
            135deg,
            #eef5ff,
            #ffffff
        );
}

.hero-content {

    display: grid;

    grid-template-columns:
        1.1fr
        0.9fr;

    align-items: center;

    gap: 70px;
}


.badge {
    display: inline-block;

    padding: 8px 14px;

    background: #e4efff;

    color: #1266f1;

    border-radius: 30px;

    font-size: 14px;

    font-weight: 700;

    margin-bottom: 20px;
}


.hero h1 {
    font-size: clamp(42px, 6vw, 70px);

    line-height: 1.05;

    margin-bottom: 25px;
}

.hero h1 span {
    color: #1266f1;
}


.hero-text p {
    max-width: 600px;

    font-size: 18px;

    color: #667085;

    margin-bottom: 30px;
}


/* BUTTONS */

.hero-buttons {
    display: flex;

    gap: 15px;

    flex-wrap: wrap;
}

.btn-primary,
.btn-secondary {

    display: inline-block;

    padding: 14px 25px;

    border-radius: 9px;

    font-weight: 700;

    transition: 0.3s;
}

.btn-primary {
    background: #1266f1;

    color: #ffffff;
}

.btn-primary:hover {
    background: #0c4fb8;

    transform: translateY(-2px);
}

.btn-secondary {

    background: white;

    color: #1266f1;

    border: 1px solid #cbd5e1;
}


/* ================= LOGO HERO ================= */

.hero-logo {
    display: flex;

    justify-content: center;
}

.logo-card {

    width: 360px;

    padding: 30px;

    background: #ffffff;

    border-radius: 22px;

    text-align: center;

    box-shadow:
        0 25px 60px
        rgba(20, 40, 80, 0.12);
}

.logo-card img {

    width: 230px;

    height: 230px;

    object-fit: contain;

    margin: auto;

    border-radius: 20px;

    background: #000000;
}

.logo-card h2 {

    margin-top: 20px;

    font-size: 25px;
}

.logo-card p {

    color: #667085;

    margin-top: 5px;
}


/* ================= SERVICES ================= */

.services {

    padding: 90px 0;

    background: #ffffff;
}

.section-title {

    max-width: 700px;

    margin:
        0 auto
        50px;

    text-align: center;
}

.section-title span,
.section-label {

    color: #1266f1;

    font-weight: 800;
}

.section-title h2,
.why-us h2 {

    font-size: 38px;

    line-height: 1.2;

    margin:
        12px 0
        15px;
}

.section-title p,
.why-us p {

    color: #667085;
}


.services-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;
}

.service-card {

    padding: 28px;

    border:
        1px solid
        #e5eaf1;

    border-radius: 15px;

    background: white;

    transition: 0.3s;
}

.service-card:hover {

    transform:
        translateY(-5px);

    box-shadow:
        0 15px 35px
        rgba(30, 50, 80, 0.08);
}

.service-icon {

    font-size: 30px;

    margin-bottom: 18px;
}

.service-card h3 {

    margin-bottom: 10px;
}

.service-card p {

    color: #667085;

    font-size: 14px;
}


/* ================= WHY ================= */

.why-us {

    padding: 90px 0;

    background: #f3f7fc;
}

.why-content {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 70px;

    align-items: center;
}

.advantages {

    display: grid;

    gap: 20px;
}

.advantage {

    display: flex;

    gap: 15px;

    padding: 20px;

    background: white;

    border-radius: 12px;
}

.advantage > span {

    width: 32px;

    height: 32px;

    display: grid;

    place-items: center;

    border-radius: 50%;

    background: #e4efff;

    color: #1266f1;

    font-weight: bold;
}


/* ================= CTA ================= */

.cta {

    padding: 80px 20px;

    text-align: center;

    background: #102a56;

    color: white;
}

.cta-logo {

    width: 90px;

    height: 90px;

    object-fit: contain;

    margin:
        0 auto 20px;

    border-radius: 15px;

    background: #000000;
}

.cta h2 {

    font-size: 38px;

    margin-bottom: 15px;
}

.cta p {

    max-width: 600px;

    margin:
        0 auto 28px;

    opacity: 0.9;
}

.cta .btn-primary {

    background: #ffffff;

    color: #1266f1;
}


/* ================= FOOTER ================= */

.footer {

    background: #101828;

    color: white;

    padding-top: 60px;
}

.footer-content {

    display: grid;

    grid-template-columns:
        2fr 1fr 1fr;

    gap: 50px;

    padding-bottom: 50px;
}

.footer-logo {

    width: 60px;

    height: 60px;

    object-fit: contain;

    border-radius: 10px;

    background: #000000;

    margin-bottom: 12px;
}

.footer h3,
.footer h4 {

    margin-bottom: 15px;
}

.footer p {

    color: #aab3c2;
}

.footer-content a {

    display: block;

    color: #aab3c2;

    margin-bottom: 9px;
}

.footer-content a:hover {

    color: white;
}

.footer-bottom {

    padding: 20px;

    text-align: center;

    border-top:
        1px solid
        #273244;

    color: #aab3c2;

    font-size: 14px;
}


/* ================= MOBILE ================= */

@media (max-width: 900px) {

    .navigation a:not(.btn-login) {
        display: none;
    }

    .hero-content,
    .why-content {

        grid-template-columns: 1fr;
    }

    .hero-text {

        text-align: center;
    }

    .hero-text p {

        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {

        justify-content: center;
    }

    .services-grid {

        grid-template-columns:
            repeat(2, 1fr);
    }

    .logo-card {

        width: 320px;
    }
}


@media (max-width: 600px) {

    .logo {

        font-size: 17px;
    }

    .logo img {

        width: 40px;
        height: 40px;
    }

    .hero {

        padding: 60px 0;
    }

    .hero h1 {

        font-size: 42px;
    }

    .hero-text p {

        font-size: 16px;
    }

    .services-grid {

        grid-template-columns: 1fr;
    }

    .why-content {

        gap: 40px;
    }

    .section-title h2,
    .why-us h2,
    .cta h2 {

        font-size: 30px;
    }

    .footer-content {

        grid-template-columns: 1fr;

        gap: 30px;
    }

    .logo-card {

        width: 100%;
    }
}
